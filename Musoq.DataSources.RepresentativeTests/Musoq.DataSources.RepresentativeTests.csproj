<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <IsPackable>false</IsPackable>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <DefaultItemExcludes>$(DefaultItemExcludes);TestsSolutions\**\*</DefaultItemExcludes>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.0.0"/>
        <PackageReference Include="MSTest.TestAdapter" Version="3.8.2"/>
        <PackageReference Include="MSTest.TestFramework" Version="3.8.2"/>
        <PackageReference Include="Musoq.Converter" Version="$(MusoqConverterVersion)" />
        <PackageReference Include="Musoq.Evaluator" Version="$(MusoqEvaluatorVersion)" />
        <PackageReference Include="Musoq.Plugins" Version="$(MusoqPluginsVersion)" />
        <PackageReference Include="Musoq.Schema" Version="$(MusoqSchemaVersion)" />
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.3.0"/>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.3.0"/>
        <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="5.3.0"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Musoq.DataSources.Tests.Common\Musoq.DataSources.Tests.Common.csproj"/>
        <ProjectReference Include="..\Musoq.DataSources.Os\Musoq.DataSources.Os.csproj"/>
        <ProjectReference Include="..\Musoq.DataSources.SeparatedValues\Musoq.DataSources.SeparatedValues.csproj"/>
        <ProjectReference Include="..\Musoq.DataSources.Time\Musoq.DataSources.Time.csproj"/>
        <ProjectReference Include="..\Musoq.DataSources.System\Musoq.DataSources.System.csproj"/>
        <ProjectReference Include="..\Musoq.DataSources.Archives\Musoq.DataSources.Archives.csproj"/>
        <ProjectReference Include="..\Musoq.DataSources.CANBus\Musoq.DataSources.CANBus.csproj"/>
        <ProjectReference Include="..\Musoq.DataSources.Docker\Musoq.DataSources.Docker.csproj"/>
        <ProjectReference Include="..\Musoq.DataSources.FlatFile\Musoq.DataSources.FlatFile.csproj"/>
        <ProjectReference Include="..\Musoq.DataSources.Json\Musoq.DataSources.Json.csproj"/>
        <ProjectReference Include="..\Musoq.DataSources.Git\Musoq.DataSources.Git.csproj"/>
        <ProjectReference Include="..\Musoq.DataSources.GitHub\Musoq.DataSources.GitHub.csproj"/>
        <ProjectReference Include="..\Musoq.DataSources.Jira\Musoq.DataSources.Jira.csproj"/>
        <ProjectReference Include="..\Musoq.DataSources.OpenAI\Musoq.DataSources.OpenAI.csproj"/>
        <ProjectReference Include="..\Musoq.DataSources.Ollama\Musoq.DataSources.Ollama.csproj"/>
        <ProjectReference Include="..\Musoq.DataSources.Roslyn\Musoq.DataSources.Roslyn.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <Content Include="Files\**\*">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
        <Content Include="Repositories\**\*">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
        <Content Include="TestsSolutions\**">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
        <Content Remove="TestsSolutions\**\obj\**"/>
        <Content Remove="TestsSolutions\**\.idea\**"/>
    </ItemGroup>

</Project>
