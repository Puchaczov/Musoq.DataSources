{
  "contract": "Musoq Search request and acceptance contract",
  "version": 1,
  "status": "proposed",
  "scope": "W01-S05",
  "implementationStatus": "The W08-S01 request-shape parser and W08-S03 scalar-literal search.many metadata, positional binding and execution are implemented and verified. Named binding requires reflected constructor metadata; regex execution, completion options and table-valued input remain later-scope work.",
  "transport": {
    "many": {
      "shape": "one scalar JSON string containing the versioned request object",
      "maxUtf16Length": 8388608,
      "diagnosticOffset": "UTF-8 byte offset within requestJson",
      "requiredArguments": ["root", "request"],
      "requestProperty": "request",
      "collectionBinding": "not assumed; scalar JSON is the compatibility fallback until runtime metadata proves otherwise"
    },
    "validationOrder": [
      "duplicate JSON property detection",
      "JSON syntax",
      "closed-schema unknown-property rejection",
      "version and enum validation",
      "pattern ID uniqueness",
      "bounds and cross-field rules",
      "filesystem access"
    ],
    "filesystemBoundary": "Invalid requests fail before opening the supplied root."
  },
  "requestSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["version", "patterns"],
    "properties": {
      "version": { "const": 1 },
      "patterns": {
        "type": "array",
        "minItems": 1,
        "maxItems": 1024,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "pattern", "mode"],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
            },
            "pattern": {
              "type": "string",
              "minLength": 1,
              "maxLength": 65536
            },
            "mode": { "enum": ["literal", "regex"] }
          }
        }
      },
      "options": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "case": { "enum": ["sensitive", "insensitive"] },
          "wholeWord": { "type": "boolean" },
          "encoding": { "enum": ["auto", "utf8", "utf8-bom", "utf16-le-bom", "utf16-be-bom"] },
          "selection": { "const": "leftmost-first-non-overlapping" },
          "take": { "type": "integer", "minimum": 1, "maximum": 1000000 },
          "partialPolicy": { "enum": ["reject", "allow"] },
          "validation": { "enum": ["full-input", "observed-prefix"] },
          "scope": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "recursive": { "type": "boolean" },
              "include": { "type": "array", "maxItems": 128, "items": { "type": "string", "maxLength": 4096 } },
              "exclude": { "type": "array", "maxItems": 128, "items": { "type": "string", "maxLength": 4096 } },
              "repositoryIgnores": { "enum": ["respect", "disabled"] },
              "globalIgnores": { "enum": ["disabled", "configured"] },
              "hiddenEntries": { "enum": ["exclude", "include"] },
              "followLinks": { "enum": ["do not follow", "follow"] },
              "inaccessibleEntries": { "enum": ["fail", "skip"] }
            }
          }
        }
      }
    }
  },
  "semanticRules": {
    "patternId": "The request property id is the stable logical PatternId used in many rows.",
    "duplicatePatternId": "Reject duplicate IDs before opening the root, even when their pattern text differs.",
    "duplicateJsonProperty": "Reject duplicate property names at every object depth; do not accept last-wins binding.",
    "unknownProperty": "Reject unknown top-level, option, scope or pattern properties; do not silently accept future options.",
    "enums": "Reject values outside the declared mode, encoding, case, policy and scope enumerations.",
    "scalarTransport": "The JSON string is decoded and validated as one complete request; a collection-valued source parameter is not presumed by documentation alone.",
    "metadata": "Metadata expectations remain proposed; positional scalar examples are verified for the literal search.many source, while named binding, collection binding and other execution modes remain later work.",
    "crossContractDefaults": "Unspecified options inherit W01-S02 match defaults and W01-S03 scope/completion defaults; the request cannot weaken containment."
  },
  "validationCases": [
    {
      "id": "unknown-top-level-property",
      "raw": "{\"version\":1,\"patterns\":[{\"id\":\"todo\",\"pattern\":\"TODO\",\"mode\":\"literal\"}],\"debug\":true}",
      "expected": "reject-unknown-property"
    },
    {
      "id": "duplicate-top-level-property",
      "raw": "{\"version\":1,\"version\":1,\"patterns\":[{\"id\":\"todo\",\"pattern\":\"TODO\",\"mode\":\"literal\"}]}",
      "expected": "reject-duplicate-json-property"
    },
    {
      "id": "duplicate-escaped-property-name",
      "raw": "{\"version\":1,\"\\u0076ersion\":1,\"patterns\":[{\"id\":\"todo\",\"pattern\":\"TODO\",\"mode\":\"literal\"}]}",
      "expected": "reject-duplicate-json-property"
    },
    {
      "id": "duplicate-pattern-id",
      "request": {
        "version": 1,
        "patterns": [
          { "id": "todo", "pattern": "TODO", "mode": "literal" },
          { "id": "todo", "pattern": "FIXME", "mode": "literal" }
        ]
      },
      "expected": "reject-duplicate-pattern-id"
    },
    {
      "id": "unknown-option",
      "raw": "{\"version\":1,\"patterns\":[{\"id\":\"todo\",\"pattern\":\"TODO\",\"mode\":\"literal\"}],\"options\":{\"fast\":true}}",
      "expected": "reject-unknown-property"
    },
    {
      "id": "invalid-pattern-mode",
      "request": {
        "version": 1,
        "patterns": [{ "id": "todo", "pattern": "TODO", "mode": "glob" }]
      },
      "expected": "reject-invalid-enum"
    },
    {
      "id": "invalid-encoding",
      "request": {
        "version": 1,
        "patterns": [{ "id": "todo", "pattern": "TODO", "mode": "literal" }],
        "options": { "encoding": "ascii" }
      },
      "expected": "reject-invalid-enum"
    }
  ],
  "acceptanceExamples": [
    {
      "id": "minimal-positional",
      "style": "positional",
      "request": {
        "version": 1,
        "patterns": [{ "id": "todo", "pattern": "TODO", "mode": "literal" }]
      },
      "sql": "SELECT Path, PatternId, MatchIndex FROM search.many('./fixture', '{\"version\":1,\"patterns\":[{\"id\":\"todo\",\"pattern\":\"TODO\",\"mode\":\"literal\"}]}')",
      "fixture": "src/a.txt contains TODO TODO; src/empty.txt is empty; src/none.txt contains DONE",
      "expectedRows": [
        { "Path": "src/a.txt", "PatternId": "todo", "MatchIndex": 0 },
        { "Path": "src/a.txt", "PatternId": "todo", "MatchIndex": 1 }
      ]
    },
    {
      "id": "minimal-named",
      "style": "named",
      "request": {
        "version": 1,
        "patterns": [{ "id": "todo", "pattern": "TODO", "mode": "literal" }]
      },
      "sql": "SELECT Path, PatternId, MatchIndex FROM search.many(root: './fixture', request: '{\"version\":1,\"patterns\":[{\"id\":\"todo\",\"pattern\":\"TODO\",\"mode\":\"literal\"}]}')",
      "fixture": "src/a.txt contains TODO TODO; src/empty.txt is empty; src/none.txt contains DONE",
      "expectedRows": [
        { "Path": "src/a.txt", "PatternId": "todo", "MatchIndex": 0 },
        { "Path": "src/a.txt", "PatternId": "todo", "MatchIndex": 1 }
      ]
    },
    {
      "id": "labeled-two-patterns",
      "style": "scalar-json",
      "request": {
        "version": 1,
        "patterns": [
          { "id": "todo-primary", "pattern": "TODO", "mode": "literal" },
          { "id": "todo-secondary", "pattern": "TODO", "mode": "literal" }
        ]
      },
      "fixture": "src/a.txt contains TODO TODO",
      "expectedRows": [
        { "Path": "src/a.txt", "PatternId": "todo-primary", "MatchIndex": 0 },
        { "Path": "src/a.txt", "PatternId": "todo-primary", "MatchIndex": 1 },
        { "Path": "src/a.txt", "PatternId": "todo-secondary", "MatchIndex": 0 },
        { "Path": "src/a.txt", "PatternId": "todo-secondary", "MatchIndex": 1 }
      ]
    }
  ],
  "sourceBasis": ["S14", "S15", "S20", "S22", "S23"]
}
